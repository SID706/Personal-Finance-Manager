# Local development defaults for docker-compose.base44.yml.
#
# This file only holds NON-PRODUCTION placeholders so the app boots in the
# sandbox. It is listed FIRST in the Compose `env_file:` list, so a real value
# delivered by the platform at /run/base44/app.env (dashboard Secrets) always
# wins. Never put real credentials in this file.

FLASK_APP=app.py
FLASK_DEBUG=true

# Local MongoDB service started by docker-compose.base44.yml.
MONGO_URI=mongodb://mongo:27017/
DB_NAME=finance_manager

# Development-only admin credentials so /initialize-admin and the admin UI can
# be exercised locally. Replace them with real values in the dashboard.
ADMIN_PASSWORD=admin-dev-password
ADMIN_SETUP_CODE=dev-setup-code

# Email (Resend) is optional: without an API key the app runs, it just does not
# send notification emails. Add a real RESEND_API_KEY in the dashboard Secrets.
DEFAULT_FROM_EMAIL=Finance Manager <no-reply@finance-manager.com>
